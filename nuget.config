<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="thermo-rawfilereader" value="third_party/Thermo.RawFileReader/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Thermo packages come only from the local folder, never from nuget.org,
       so a package with the same name on nuget.org cannot replace them. -->
  <packageSourceMapping>
    <packageSource key="thermo-rawfilereader">
      <package pattern="ThermoFisher.CommonCore.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
